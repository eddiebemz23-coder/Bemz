# Bemz Africa Marketplace — environment template
#
# Copy to `.env` and fill in. `cp .env.example .env`
#
# Every key below is read by `src/lib/env.ts`; nothing here is decorative. The schema is the
# authority — if you add a variable, add it to that file too or it will be ignored.
#
# ONLY TWO KEYS ARE REQUIRED TO BOOT: DATABASE_URL and NEXTAUTH_SECRET.
# Every optional credential may be left BLANK (`KEY=""` or `KEY=`): `env.ts` treats an empty
# string as unset, so the matching rail switches itself off instead of crashing the app.
# In non-production those rails fall back to a sandbox that records payments as succeeded with
# a `SIM-` reference, which is how you test the whole checkout with no operator account.

# ── Runtime ───────────────────────────────────────────────────────────────────
# `production` disables every sandbox: unconfigured payment rails throw instead of faking
# success, and OTP codes stop being returned to the browser. Never set it locally.
NODE_ENV="development"

# ── Database (PostgreSQL 14+) ─────────────────────────────────────────────────
# DATABASE_URL is what the app queries at runtime. With a managed provider this should be the
# POOLED connection (Supabase: port 6543, `?pgbouncer=true&connection_limit=1`).
DATABASE_URL="postgresql://bemz:bemz_dev_password@localhost:5432/bemz_marketplace?schema=public"

# DIRECT_URL is the non-pooled session connection, used only by `prisma migrate deploy` /
# `db:push` — DDL cannot run through a transaction-mode pooler. Optional locally (the app falls
# back to DATABASE_URL); REQUIRED in production whenever DATABASE_URL is pooled.
DIRECT_URL="postgresql://bemz:bemz_dev_password@localhost:5432/bemz_marketplace?schema=public"

# ── App origin ────────────────────────────────────────────────────────────────
# Public base URL of this deployment. Used for absolute links in SMS/notifications, the return
# URL after a card payment, and Cloudinary/Airtime callbacks. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth (NextAuth.js) ────────────────────────────────────────────────────────
# NextAuth needs its own origin cookie scope. Set it to the same value as NEXT_PUBLIC_APP_URL.
NEXTAUTH_URL="http://localhost:3000"
# REQUIRED. Minimum 16 characters. Generate one: `openssl rand -base64 32`
NEXTAUTH_SECRET=""

# bcrypt cost factor for password accounts (OTP-only buyers have no password). 8–15, default 12.
AUTH_PASSWORD_SALT_ROUNDS=12

# Phone-login one-time codes. `requestOtp` returns the code to the caller outside production so
# you can log in without an SMS account; in production it never does.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Fixed-window limiter on login/OTP routes. In-process and per-instance — see the note in
# `src/lib/rate-limit.ts` before running more than one server.
AUTH_RATE_LIMIT_PER_MINUTE=20

# ── Cloudinary (product images + KYC documents) ───────────────────────────────
# Leave all three blank to run without uploads: the API returns a clear 503 instead of
# pretending the file landed, and seeded listings use remote placeholder URLs.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Must be a SIGNED upload preset in your Cloudinary console (upload_type = "signed").
CLOUDINARY_UPLOAD_PRESET="bemz-product"
# KYC documents get their own folder so they never sit in the public product CDN path.
CLOUDINARY_KYC_FOLDER="bemz/kyc"
CLOUDINARY_PRODUCT_FOLDER="bemz/products"

# ── SMS gateway (Africa's Talking covers UG + KE short codes) ─────────────────
# Without these, OTPs and order messages are written to the Notification table as
# `simulated:<id>` and logged as `[sms:simulated] -> <phone>: <body>`.
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
# Sender ID must be a registered short code/alphanumeric sender in each country you send to.
AFRICASTALKING_SENDER_ID="BEMZ"

# ── MTN Mobile Money (MoMo Open API, Uganda collections) ──────────────────────
MTN_MOMO_BASE_URL="https://momoapi.mtn.co.ug/momo/api/v1"
# The rail activates only when API_USER + API_SECRET + SUBSCRIPTION_KEY are all present.
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_SECRET=""
# Used to build the `X-Ocp-API-Subscription-Key` style headers some MoMo environments expect.
MTN_MOMO_PRIMARY_KEY=""
# Base for the per-transaction notification URL we hand to operators; the Airtel adapters append
# their own rail segment (`/airtel-ug`, `/airtel-ke`), so give the `/api/webhooks` directory, NOT
# a full endpoint. MTN takes no per-transaction URL — register the callback host
# `<this value>/payments/mtn-momo` in the MoMo developer portal instead.
# In production this must be publicly reachable over HTTPS.
MTN_MOMO_CALLBACK_BASE_URL="http://localhost:3000/api/webhooks"
# The merchant account (target) money is collected into — your MoMo merchant number.
MTN_MOMO_COLLECTION_TARGET="bemz_marketplace"

# ── Airtel Money (separate products in Uganda and Kenya) ──────────────────────
AIRTEL_BASE_URL_UG="https://mobileairtimeapi.airtel.co.ug/msisdn/api"
AIRTEL_BASE_URL_KE="https://airteloutsourcing.com/merchantapi"
AIRTEL_CLIENT_ID_UG=""
AIRTEL_CLIENT_SECRET_UG=""
AIRTEL_MERCHANT_CODE_UG=""
AIRTEL_CLIENT_ID_KE=""
AIRTEL_CLIENT_SECRET_KE=""
AIRTEL_MERCHANT_CODE_KE=""
# Airtel's own sandbox hosts, as opposed to going straight at live rails.
AIRTEL_USE_SANDBOX="true"

# ── Stripe (cards, for diaspora and cross-border buyers) ──────────────────────
# Secret key format `sk_test_…` / `sk_live_…`. Webhook secret comes from
# `stripe webhook create` (local) or the Dashboard endpoint (hosted); it signs the raw body.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Platform economics ────────────────────────────────────────────────────────
# Basis points: 1250 = 12.5%. All money in this codebase is integer MINOR units
# (UGX/KES cents, USD cents), so `SELLER_PAYOUT_MIN_MINOR=10000000` is UGX 100,000.
COD_ENABLED="true"
PLATFORM_COMMISSION_DEFAULT_BPS=1250
SELLER_PAYOUT_MIN_MINOR=10000000
# Days after delivery before a parcel's money becomes withdrawable — the dispute window.
SELLER_SETTLEMENT_DELAY_DAYS=7

# ── Operations ────────────────────────────────────────────────────────────────
# Bearer token for `POST /api/ops/expire-orders` (the abandoned-checkout sweep). Use a cron or
# scheduler rather than leaving it unset: with no token only a signed-in ADMIN can run it, so
# reserved stock would sit until someone remembers to click. Minimum 16 characters.
#   curl -X POST https://your-domain.com/api/ops/expire-orders -H "Authorization: Bearer $TOKEN"
OPS_SWEEP_TOKEN=""
